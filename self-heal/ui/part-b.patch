+function short(s,n=64){ if(!s) return ""; return s.length>n?s.slice(0,n-1)+"…":s; }
+function escapeHtml(s){ return String(s).replace(/[&<>"]/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[m])); }
+
+function renderInsight(ins, caseId){
+  const row=el("div","insight");
+  const head=el("div","insight-head");
+  head.innerHTML=`<span class="ih-title">▸ ${ins.title}</span>`+
+    (ins.conf?`<span class="ih-conf">confidence ${ins.conf}</span>`:"")+
+    `<span class="prov ${ins.prov}">${ins.prov}</span>`;
+  row.appendChild(head);
