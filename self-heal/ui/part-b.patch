+      `<div>${fails.filter(f=>f.d).length} real (has defect ref) · ${fails.filter(f=>!f.d).length} unclustered · flagged flaky candidates: <b>TC-C6</b>.</div></div>`+
+      (fails.length?`<div class="m-section"><div class="m-lbl">Failures</div><ul>${failList}</ul></div>`:""),
+    footHtml:`<span class="audit">Provenance: measured (counts) · proxy (cluster)</span><div class="spacer"></div>`+
