+// -------------- Row menu (⋯ on failed rows) --------------
+function openRowMenu(triggerEl, caseId, runId){
+  document.querySelectorAll(".rowmenu").forEach(x=>x.remove());
+  const rect=triggerEl.getBoundingClientRect();
+  const menu=el("div","rowmenu");
+  const mk=(lbl,fn)=>{const b=el("button",null,lbl);b.addEventListener("click",e=>{e.stopPropagation();menu.remove();fn();});return b;};
+  menu.appendChild(mk("Explain failure",()=>openConfirmModal({
+    title:`Explain failure · ${caseId}`,
+    body:`Heuristic explanation for <b>${caseId}</b>: latest run failed with an expected-value mismatch. Likely candidates: recent oracle drift (see Learn-from-bug in drawer), platform-specific rendering, or flaky env.`,
+    accept:"OK", onAccept:()=>{}
+  })));
+  menu.appendChild(mk("Create defect",()=>openConfirmModal({
+    title:`Create defect · ${caseId}`,
+    body:`Draft a JIRA defect for <b>${caseId}</b>? A ticket stub will be prepared with run + oracle context.`,
+    accept:"Create defect", onAccept:()=>toast(`Defect drafted for ${caseId} (mock)`)
+  })));
+  menu.appendChild(mk("Retry",()=>openConfirmModal({
+    title:`Retry ${caseId}`,
+    body:`Queue <b>${caseId}</b> for re-run on the same platform/build?`,
+    accept:"Retry", onAccept:()=>toast(`${caseId} queued for retry (mock)`)
+  })));
+  menu.style.left=Math.round(rect.right-150)+"px";
+  menu.style.top=Math.round(rect.bottom+4)+"px";
+  document.body.appendChild(menu);
+  const off=(ev)=>{ if(!menu.contains(ev.target)){ menu.remove(); document.removeEventListener("click",off);} };
+  setTimeout(()=>document.addEventListener("click",off),0);
+}
+
+// -------------- Conversational authoring bar --------------
+STATE.draft = null;   // {title, category, steps, data, trace}
+STATE.pendingIntent = null; // {kind, base}
+
+const CBAR_EXAMPLES = [
+  'what failed on mobile this release?',
+  'which cases cover AC-PN2?',
+  'mark TC-A3 as automated',
+  'add a negative case for expired NRIC at submission',
+];
+
+function initCbar(){
+  const ex = $("#cbarExamples");
+  CBAR_EXAMPLES.forEach(t=>{
+    const c=el("span","ex",escapeHtml(t));
+    c.addEventListener("click",()=>{ $("#cbarInput").value=t; $("#cbarInput").focus(); });
+    ex.appendChild(c);
+  });
+  $("#cbarSubmit").addEventListener("click",submitCbar);
+  $("#cbarInput").addEventListener("keydown",e=>{
+    if(e.key==="Enter"){ e.preventDefault(); submitCbar(); }
+    if(e.key==="Escape"){ clearCbar(); }
+  });
+  // "/" focuses the bar when not typing in a field
+  document.addEventListener("keydown",e=>{
+    if(e.key==="/" && document.activeElement.tagName!=="INPUT" && document.activeElement.tagName!=="TEXTAREA"){
+      e.preventDefault(); $("#cbarInput").focus();
+    }
+  });
+}
+
+function cbarChat(html){
+  const box=$("#cbarChat"); box.style.display="block"; box.innerHTML=html;
+}
+function cbarClarify(html){ const box=$("#cbarClarify"); box.style.display="flex"; box.innerHTML=html; }
+function clearCbar(){
+  $("#cbarChat").style.display="none";
+  $("#cbarClarify").style.display="none";
+  $("#cbarInput").value="";
+  STATE.pendingIntent=null;
+  STATE.draft=null;
+  render();
+}
+
+// Small intent table.
+function classifyIntent(q){
+  const s=q.trim().toLowerCase();
+  if(!s) return {kind:"empty"};
+  // read-only queries
+  if(/^what\s+failed/.test(s) || /failed on (mobile|web)/.test(s))
+    return {kind:"query-failed-platform", platform: /mobile/.test(s) ? "mobile" : "web"};
+  if(/^which cases (cover|trace)/.test(s) || /cover[s]?\s+(ac-|fhr-req-)/.test(s)){
+    const m=s.match(/(ac-[a-z0-9]+|fhr-req-\d+)/i);
+    return {kind:"query-cover", tag: m?m[1].toUpperCase():null};
+  }
+  // clear mutating
+  const auto=s.match(/mark\s+(tc-[a-z0-9]+)\s+as\s+automated/i);
+  if(auto) return {kind:"mutate-mark-auto", tcId: auto[1].toUpperCase()};
+  // ambiguous mutating
+  if(/^add (a )?(negative|edge|boundary|positive) case/.test(s))
+    return {kind:"ambiguous-add", text:q};
+  return {kind:"unknown", text:q};
+}
+
+function submitCbar(){
+  const q=$("#cbarInput").value;
+  const intent=classifyIntent(q);
+  $("#cbarChat").style.display="none";
+  $("#cbarClarify").style.display="none";
+
+  if(intent.kind==="empty") return;
+
+  if(intent.kind==="query-failed-platform"){
+    const fails=[];
+    RELEASES.forEach(rel=>rel.runs.forEach(run=>{
+      if(run.platform!==intent.platform) return;
+      run.results.filter(r=>r.s==="fail").forEach(r=>fails.push({c:r.c,d:r.d,run:run.id,rel:rel.id}));
+    }));
+    const list = fails.length
+      ? "<ul style=\"margin:6px 0 0;padding-left:18px;\">"+fails.map(f=>`<li><b>${f.c}</b> — ${escapeHtml(CASES[f.c]?CASES[f.c].title:"")} <span class="mono">(${f.run}${f.d?"; "+f.d:""})</span></li>`).join("")+"</ul>"
+      : "<i>none in the observed data.</i>";
+    cbarChat(`Failed on ${PLAT_ICON[intent.platform]} ${intent.platform} across observed releases: <b>${fails.length}</b>.${list} <div class="muted" style="font-size:11px;margin-top:6px;">provenance: measured (from run data)</div>`);
+    return;
+  }
+  if(intent.kind==="query-cover"){
+    const tag=intent.tag;
+    const matches = Object.values(CASES).filter(tc=>tc.req===tag || (tc.traces||[]).includes(tag));
+    const list = matches.length
+      ? "<ul style=\"margin:6px 0 0;padding-left:18px;\">"+matches.map(tc=>`<li><b>${tc.id}</b> — ${escapeHtml(tc.title)}</li>`).join("")+"</ul>"
+      : "<i>no direct matches — try an AC-* or trace tag.</i>";
+    cbarChat(`Cases covering <b>${escapeHtml(tag||"—")}</b>: <b>${matches.length}</b>.${list}`);
+    return;
+  }
+  if(intent.kind==="mutate-mark-auto"){
+    if(!CASES[intent.tcId]){
+      cbarChat(`<i>${escapeHtml(intent.tcId)} not found.</i>`); return;
+    }
+    STATE.draft = {
+      kind:"mark-auto", title:`Mark ${intent.tcId} as automated`,
+      lifecycle:"draft", ref:intent.tcId,
+      steps:[`Set exec=auto on ${intent.tcId}`, `Recompute Auto/Manual counts`],
+      data:[{k:"Case",v:intent.tcId},{k:"Change",v:"exec: manual → auto"}],
+    };
+    render();
+    return;
+  }
+  if(intent.kind==="ambiguous-add"){
+    STATE.pendingIntent={kind:"add-neg-case", base:intent.text};
+    cbarClarify(`<span class="q">Web, mobile, or both?</span>`+
+      ["Web","Mobile","Both"].map(p=>`<button class="chip-btn" data-plat="${p}">${p}</button>`).join(""));
+    document.querySelectorAll(".cbar-clarify .chip-btn").forEach(b=>{
+      b.addEventListener("click",()=>{
+        const plat=b.dataset.plat;
+        $("#cbarClarify").style.display="none";
+        STATE.draft={
+          kind:"new-case",
+          title:"Decline submission when NRIC has expired",
+          category:"negative",
+          platform:plat,
+          steps:[
+            "Enter expired NRIC (2019-03-01)",
+            "Attempt submission → expect validation error"
+          ],
+          data:[{k:"NRIC expiry",v:"2019-03-01"},{k:"Platform",v:plat}],
+          trace:"FHR-REQ-022",
+          lifecycle:"draft",
+        };
+        STATE.pendingIntent=null;
+        render();
+      });
+    });
+    return;
+  }
+  cbarChat(`<i>I don't recognise that intent yet. Try one of the examples.</i>`);
+}
+
+function draftCardEl(d){
+  const c=el("div","draft-card");
+  const head=el("div","dc-head");
+  head.innerHTML=`<span class="cid">DRAFT · TC-305</span>`+
+    `<span class="dc-title">${escapeHtml(d.title)}</span>`+
+    (d.category?`<span class="ctype cat-${d.category}">${d.category}</span>`:"")+
+    `<span class="lifecycle lc-draft">Draft</span>`;
+  c.appendChild(head);
+  const body=el("div","dc-body");
+  let inner="";
+  if(d.steps && d.steps.length){
+    inner += `<div><b>Steps:</b> `+d.steps.map((s,i)=>`${i+1} ${escapeHtml(s)}`).join(" → ")+`</div>`;
+  }
+  if(d.data && d.data.length){
+    inner += `<div style="margin-top:4px;"><b>Data:</b> `+d.data.map(x=>`${escapeHtml(x.k)} = ${escapeHtml(x.v)}`).join(", ")+`</div>`;
+  }
+  if(d.trace){ inner += `<div style="margin-top:4px;"><b>Trace:</b> <span class="tracetag reg">${escapeHtml(d.trace)}</span></div>`; }
+  if(d.platform){ inner += `<div style="margin-top:4px;color:var(--ink-3);font-size:11px;">Platform scope: ${escapeHtml(d.platform)}</div>`; }
+  body.innerHTML=inner;
+  c.appendChild(body);
+  const acts=el("div","dc-actions");
+  const bAcc=el("button","btn btn-primary","Accept & add");
+  bAcc.addEventListener("click",()=>{ STATE.draft=null; toast("Draft added (mock)"); render(); });
+  const bEdit=el("button","btn","Edit");
+  bEdit.addEventListener("click",()=>{ toast("Edit not wired in mock"); });
+  const bDis=el("button","btn","Discard");
+  bDis.addEventListener("click",()=>{ STATE.draft=null; render(); });
+  acts.appendChild(bAcc); acts.appendChild(bEdit); acts.appendChild(bDis);
+  c.appendChild(acts);
+  return c;
+}
+
+// -------------- Toast --------------
+let _toastTimer=null;
+function toast(msg){
+  const t=$("#toast"); t.textContent=msg; t.classList.add("show");
+  clearTimeout(_toastTimer);
+  _toastTimer=setTimeout(()=>t.classList.remove("show"),1900);
+}
+
+// -------------- Extend Esc to close modal + row menu --------------
+document.addEventListener("keydown",e=>{
+  if(e.key==="Escape"){
+    closeModal();
+    document.querySelectorAll(".rowmenu").forEach(x=>x.remove());
+  }
+});
+
 // init
 STATE.modScenario={f:0,s:0};
 STATE.releaseRun={r:0,k:0};
 renderTree();
 render();
+initCbar();
 </script>
