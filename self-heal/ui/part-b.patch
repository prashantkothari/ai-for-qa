+    {title:"Whitespace-only input", cat:"negative", conf:"●●●○", prov:"measured", why:"Common oversight in similar boundary sets."},
+    {title:"Locale-formatted digits (SG vs US separators)", cat:"boundary", conf:"●●○○", prov:"proxy", why:"Data-variation gap seen in adjacent scenarios."},
+    {title:"Copy-paste emoji or RTL chars into amount field", cat:"negative", conf:"●●○○", prov:"proxy", why:"Historical bugs (JIRA-7841 family) hint at sanitizer gaps."},
+    {title:"Abstain — value-boundary rule at zero for optional needs", cat:"—", conf:"", prov:"abstained", why:"Rule unspecified; cannot assert oracle."},
+  ];
